# Copy is written to .env by `pnpm seed`, with generated values for the secrets below.
# Everything here is a local test value for this reproduction app only.
DATABASE_URL=file:./payload-mcp-repro.db
PAYLOAD_SECRET=generated-by-pnpm-seed

# Where the repro scripts reach the app (pnpm dev serves on port 3000 by default)
BASE_URL=http://localhost:3000

# User A: the MCP client acts as this user
USER_A_EMAIL=user-a@example.test
USER_A_PASSWORD=generated-by-pnpm-seed
USER_A_MCP_API_KEY=generated-by-pnpm-seed

# User B: holds the document lock (as if editing the post in the admin panel)
USER_B_EMAIL=user-b@example.test
USER_B_PASSWORD=generated-by-pnpm-seed
USER_B_MCP_API_KEY=generated-by-pnpm-seed
